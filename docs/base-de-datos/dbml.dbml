Table users {
  id int [pk, increment]
  fullname varchar(100) [not null]
  username varchar(100) [not null, unique]
  email varchar(150) [not null, unique]
  password varchar(255) [not null]
  role varchar(30) [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table categories {
  id int [pk, increment]
  name varchar(100) [not null, unique]
  description text
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table tags {
  id int [pk, increment]
  name varchar(50) [not null, unique]
  color varchar(8) [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table products {
  id int [pk, increment]
  category_id int [not null]
  name varchar(150) [not null]
  description text
  price decimal(10,2) [not null]
  cost decimal(10,2) [not null]
  stock int [not null, default: 0]
  min_stock int [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (is_active) [name: 'idx_products_active']
    (category_id) [name: 'idx_products_category']
    (name) [name: 'idx_products_name']
  }
}

Table product_tags {
  product_id int [not null]
  tag_id int [not null]

  indexes {
    (product_id, tag_id) [pk, name: 'pk_product_tags']
  }
}

Table sales {
  id int [pk, increment]
  user_id int [not null]
  number int [not null, unique]
  payment_method varchar(30) [not null]
  total decimal(10,2) [not null]
  status varchar(20) [not null, default: 'completed']
  created_at timestamptz [not null, default: `now()`]
  cancelled_at timestamptz
  cancelled_by int
  cancellation_reason text

  indexes {
    (created_at) [name: 'idx_sales_date']
    (user_id) [name: 'idx_sales_user']
  }
}

Table sale_products {
  sale_id int [not null]
  product_id int [not null]
  product_name varchar(150) [not null]
  quantity int [not null]
  unit_price decimal(10,2) [not null]
  subtotal decimal(10,2) [not null]

  indexes {
    (sale_id, product_id) [pk, name: 'pk_sale_products']
    (product_id) [name: 'idx_sale_products_product']
  }
}

Ref: products.category_id > categories.id

Ref: product_tags.product_id > products.id
Ref: product_tags.tag_id > tags.id

Ref: sales.user_id > users.id
Ref: sales.cancelled_by > users.id

Ref: sale_products.sale_id > sales.id
Ref: sale_products.product_id > products.id
