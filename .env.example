# Variables de la API. Copiar este archivo a `.env` en la raíz del repositorio
# y ajustar los valores. El `.env` no se versiona.
#
# En Render las variables se cargan desde el panel del servicio y tienen
# prioridad sobre el `.env` local.

# Puerto de la API (Render lo inyecta solo en producción).
PORT=3000

# Secreto para firmar los JWT. En producción usar un valor largo y aleatorio
# (por ejemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))").
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=8h

# Usuario administrador que crea `npm run db:setup -w api`.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Base de datos local por defecto.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/utn_tfi
# En bases alojadas (Render, Neon) el SSL se activa solo porque el host no es
# local. Usar true solo para forzarlo.
# DATABASE_SSL=true

# Orígenes permitidos por CORS, separados por comas.
# En producción: https://tu-proyecto.vercel.app
CLIENT_URL=http://localhost:5173
